{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake configure",
            "type": "shell",
            "command": "cmake",
            "args": ["-B", "build", "-DCMAKE_BUILD_TYPE=Debug"],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "cmake build",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build", "--config", "Debug"],
            "group": "build",
            "dependsOn": ["cmake configure"],
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "build",
            "dependsOn": ["cmake build"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}